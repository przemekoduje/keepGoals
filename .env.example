# Konfiguracja Google Gemini (wyłączny silnik AI w KeepGoals)
GEMINI_API_KEY=

# Ścieżka do klucza serwisowego Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=firebase-adminsdk.json

# Konfiguracja SMTP (wysyłka notatek i powiadomień e-mail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
